#Env Assembly

// --- Global Design Parameters ---

// Main wooden stand body
params plate_w=80, plate_l=220, plate_t=12
params tilt=22 // Leaning angle backward from vertical

// Base support leg
params leg_w=14
params leg_len=80
params leg_tip_h=10
params leg_contact_s=75

// Front-face surface offset coordinates (for mounting hardware flush to the front face)
params front_y_off=@(-$plate_t * @CosDeg($tilt))
params front_z_off=@($plate_t * @SinDeg($tilt))

// Earbud resting pins (brass dowels)
params peg_r=1.8, peg_len=16
params peg_tilt=5 // Slight upward tilt so earbuds cannot slip off

// Middle cable splitter guide fork (pair of 2 pins)
params mid_peg_r=1.3, mid_peg_len=11
params mid_peg_y=125
params mid_peg_spacing=7.5 // Gap between centers to guide the cord

// Wooden wire wrap spool
params spool_y=80
params spool_post_r=9, spool_post_len=13
params spool_cap_r=27, spool_cap_t=4.5


// --- Components ---

// 1. Main Wooden Plate
part name=MainPlate
    .rx = @(90 - $tilt)

    sketch name=PlateProfile
        rect point1=@point(-$plate_w/2, 0) point2=@point($plate_w/2, $plate_l) mode=2p filletradius=6
    endsketch
    
    extrude profile=#PlateProfile distance=$plate_t mode=add
endpart

// 2. Base Support Leg (Features the arched relief cutout on the underside)
part name=BaseLeg
    .ry = 90
    .rx = 90
    .translate = @vector(-$leg_w/2, 0, 0)

    sketch name=LegProfile
        pline pointlist=[
            @point(0, 0),
            @point(15, 0),
            @point(38, 10),
            @point(58, 0),
            @point($leg_len, 0),
            @point($leg_len, $leg_tip_h),
            @point(@($leg_contact_s * @SinDeg($tilt)), @($leg_contact_s * @CosDeg($tilt)))
        ] closed=true
    endsketch
    
    extrude profile=#LegProfile distance=$leg_w mode=add
endpart

// 3. Left Earbud Resting Pins (Angled cradle pair)
part name=EarbudPegLeftOuter
    .rx = @(90 - $tilt - $peg_tilt)
    .translate = @vector(-26, @(172 * @SinDeg($tilt) + $front_y_off), @(172 * @CosDeg($tilt) + $front_z_off))
    cylinder radius=$peg_r height=$peg_len
endpart

part name=EarbudPegLeftInner
    .rx = @(90 - $tilt - $peg_tilt)
    .translate = @vector(-17, @(177 * @SinDeg($tilt) + $front_y_off), @(177 * @CosDeg($tilt) + $front_z_off))
    cylinder radius=$peg_r height=$peg_len
endpart

// 4. Right Earbud Resting Pins (Angled cradle pair)
part name=EarbudPegRightInner
    .rx = @(90 - $tilt - $peg_tilt)
    .translate = @vector(17, @(177 * @SinDeg($tilt) + $front_y_off), @(177 * @CosDeg($tilt) + $front_z_off))
    cylinder radius=$peg_r height=$peg_len
endpart

part name=EarbudPegRightOuter
    .rx = @(90 - $tilt - $peg_tilt)
    .translate = @vector(26, @(172 * @SinDeg($tilt) + $front_y_off), @(172 * @CosDeg($tilt) + $front_z_off))
    cylinder radius=$peg_r height=$peg_len
endpart

// 5. Middle Cable Guide Fork (Pair of 2 cylinders)
part name=CableGuidePeg qty=2 newdef=true
    .rx = @(90 - $tilt - $peg_tilt)
    .translate = @vector(@(($index - 1.5) * $mid_peg_spacing), @($mid_peg_y * @SinDeg($tilt) + $front_y_off), @($mid_peg_y * @CosDeg($tilt) + $front_z_off))
    cylinder radius=$mid_peg_r height=$mid_peg_len
endpart

// 6. Wire Spool Core Post
part name=SpoolPost
    .rx = @(90 - $tilt)
    .translate = @vector(0, @($spool_y * @SinDeg($tilt) + $front_y_off), @($spool_y * @CosDeg($tilt) + $front_z_off))
    cylinder radius=$spool_post_r height=$spool_post_len
endpart

// 7. Wire Spool Front Retaining Cap
part name=SpoolCap
    .rx = @(90 - $tilt)
    .translate = @vector(0, @($spool_y * @SinDeg($tilt) + $front_y_off - $spool_post_len * @CosDeg($tilt)), @($spool_y * @CosDeg($tilt) + $front_z_off + $spool_post_len * @SinDeg($tilt)))
    cylinder radius=$spool_cap_r height=$spool_cap_t
endpart